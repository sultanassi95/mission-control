# Allowlist: only the OS is tracked. Anything else you place at the root
# (your project repos, scratch folders) is invisible to this repo's git.
/*
!/framework/
!/tools/
!/_command/
!/LIFTOFF.md
!/CLAUDE.md
!/README.md
!/CHANGELOG.md
!/LICENSE
!/.gitignore
!/.gitattributes

# .claude ships ONLY its skills (auto-discovered on clone); session-local
# files (settings.local.json, caches) must never be tracked.
!/.claude/
/.claude/*
!/.claude/skills/

# operator-local; never ships
tools/leak-sweep.private.txt

# per-machine platform profile; never travels between machines
_command/machine.local.md

# founder's internal project docs (allowlist already excludes; explicit for safety)
.project/

# optional fronts/ container: host your project repos here (moved or copied in),
# each keeping its own git, invisible to this repo via the allowlist. Explicit
# for clarity. See framework/task-board.md (front placement).
fronts/

# ticket payload files - samples, artifacts, screenshots - contained inside the
# ticket's own folder, never versioned or shipped. Scoped to tasks/<ID>-<slug>/ so
# a samples/ or artifacts/ directory belonging to product code is never swallowed.
# ticket.md and scripts/ sit in the same folder and ARE tracked.
**/tasks/*/samples/
**/tasks/*/artifacts/
**/tasks/*/screenshots/

# retired location, kept ignored on purpose. Payloads used to live in a sibling
# .tickets/<ID>-<slug>/ tree (MC-003, superseded by MC-005). An instance whose
# spokes still name that path must not be able to commit what it writes there, and
# those spokes live outside this repo where this change cannot reach them.
.tickets/

# generated by the optional docs-viewer skill (any depth)
node_modules/
.docs-viewer-cache/
